# 複製這個檔案為 .env（同資料夾），並填入你的值。.env 已加進 .gitignore，不會被 commit。

# ---- OKX 商品篩選門檻 ----
MIN_VOL_USDT=50000000
MIN_AMPLITUDE_PCT=3.0
TOP_N=6
# 逗號分隔的關鍵字，讓非 *-USDT-SWAP 的商品（例如未來 OKX 上架的黃金指數合約）也能被篩選到
EXTRA_INSTRUMENT_KEYWORDS=

# ---- 技術面策略參數 ----
EMA_PERIOD=20
BOX_LOOKBACK=15
CANDLE_BAR=5m
CANDLE_LIMIT=50
# 停利風報比：TP1 = 停損距離 x TP1_RR，TP2 = 停損距離 x TP2_RR
TP1_RR=1.5
TP2_RR=2.0
# 量能突破確認：突破那根K線成交量要達到盒子回看窗平均量的這個倍數以上才算有效突破，
# 過濾量能稀薄的雜訊假突破。設 0 代表完全不啟用
VOLUME_CONFIRM_MULTIPLE=1.1

# ---- 多時間週期共振（見 strategy.compute_trend_bias） ----
# 5分鐘線突破時，額外確認更高週期的大方向沒有明顯反向
HTF_BAR=1H
HTF_EMA_PERIOD=20
HTF_CANDLE_LIMIT=50

# ---- 每日虧損斷路器（見 outcome_tracker.compute_daily_circuit_breaker） ----
# 今天觸及停損的次數達到這個數字，或今天累積R倍數低於 MAX_DAILY_LOSS_R，之後的新訊號
# 一律標示「今日已達虧損上限」。設 0（次數）或 0 以上（R）代表關閉那一項門檻
MAX_DAILY_LOSS_COUNT=3
MAX_DAILY_LOSS_R=-5.0

# ---- 歷史回測（把策略規則套在過去的 K 線上重播統計，見 backtest.py） ----
# OKX /market/candles 單次查詢上限 300 根，這裡不能設超過這個值
BACKTEST_CANDLE_LIMIT=300

# ---- 當沖手續費（把風報比換算成扣掉來回手續費的「淨盈虧比」，見 fee_calc.py） ----
# OKX 永續合約一般用戶預設費率參考值（%），假設進出場都用市價單（Taker）搶時間
TAKER_FEE_PCT=0.05
# 淨盈虧比至少要達到這個倍數才算「值得進場」，太薄的行情就算技術面突破也會被標示警告
MIN_NET_RR=1.0

# ---- 訊號觸發通知（Telegram，選用，見 telegram_notify.py） ----
# 跟 @BotFather 對話建立 Bot 拿到 Token；chat_id 最簡單的取得方式是先跟 Bot 說一句話，
# 再打開 https://api.telegram.org/bot<TOKEN>/getUpdates 查 message.chat.id
# 兩個都留空就完全停用，不影響任何其他功能
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- 訊號觸發通知（Email，選用，見 email_notify.py） ----
# 用一般 SMTP 帳號寄信（Gmail 等服務通常要用「應用程式密碼」，不是登入密碼本身）
# 5 個欄位都留空就完全停用，不影響任何其他功能
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# ---- 背景排程自動分析（選用，預設關閉，見 scheduler.py） ----
# 開啟後系統會照下面的間隔自動觸發一輪分析（跟按「立即分析」一樣的邏輯），不用手動點擊。
# 這跟本系統原本「用量完全由使用者點擊次數決定」的設計精神不同，所以刻意預設關閉，需要
# 透過 POST /api/v1/scheduler 主動開啟。開關/間隔實際存在 SQLite，之後可以直接呼叫這支
# API 調整，不用改這裡重啟伺服器——這裡的兩個變數只是「資料庫還沒被設定過時」的起始值。
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=1800
# 上面兩個不管怎麼設，實際間隔都不會短於 900 秒（寫死在 config.py 的
# SCHEDULER_MIN_INTERVAL_SECONDS，不開放調整），防止設定錯誤變成失控的高頻迴圈。

# ---- 背景排程模式下的 AI 用量治理（見 ai_governor.py） ----
# 規則大腦（技術面 EMA/突破/量能/趨勢）每一輪排程都會跑，零額外成本；AI 新聞情緒不是
# 每輪都問，靠以下三道防線把關（手動按「立即分析」不受這三個限制，一律照舊每次都問 AI）：
# 1. 節流週期：預設每 3 輪才問一次，除非這輪剛好有新技術訊號，那種情況一律優先問。
AI_REFRESH_EVERY_N_CYCLES=3
# 2. 每日呼叫上限：0 代表不限制。
AI_DAILY_CALL_CAP=48
# 3. 連續失敗斷路器：AI 連續失敗達這個次數就暫停呼叫，直到使用者下一次手動「立即分析」
#    重置這個計數。0 代表不啟用這道防線。
AI_FAILURE_THRESHOLD=3

# ---- 死人開關監控（選用，見 healthcheck.py） ----
# 只有真的把上面的背景排程長期跑在自己的伺服器上才需要設定；留空（預設）完全不影響
# 任何功能。填一個 healthchecks.io 的 ping 網址（免費方案就夠用），每輪排程分析跑完
# （不管成功或失敗）就會 ping 一次，讓它幫你偵測「排程是不是太久沒動靜」——伺服器
# 整台當掉這種狀況，系統自己是不可能通知你的。
HEALTHCHECK_PING_URL=

# ---- 使用者自訂警報（選用，見 alerts.py） ----
# repeat_mode="repeating" 的警報，距離上次觸發至少要過這麼多秒才允許再通知一次，避免
# 同一個條件持續成立時每輪分析都推播一次（通知疲勞）。
ALERT_MIN_RETRIGGER_SECONDS=3600
# 警報總數上限（不分商品），防止無上限累積；到上限後 POST /api/v1/alerts 會拒絕新建。
ALERT_MAX_TOTAL=50

# ---- 推薦強度榜 ----
RANKING_TOP_N=5

# ---- 訊號結果追蹤與自動優化 ----
# 每次分析回頭結算舊訊號時，要抓多少根已收盤 K 線（OKX /market/candles 單次上限 300）
RESOLUTION_LOOKBACK_CANDLES=300
# 訊號追蹤超過這麼久還沒結果就標記為「逾期」，不再無限期追蹤（當沖訊號本不該留倉過夜）
SIGNAL_EXPIRE_HOURS=25

# ---- AI 新聞情緒大腦 ----
# anthropic | openai | none（none = 完全停用 AI，訊號只看技術面，不用填任何金鑰）
AI_PROVIDER=anthropic

# 建立 Anthropic API 金鑰：https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# 建立 OpenAI API 金鑰（若 AI_PROVIDER=openai）：https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- 美股代幣公司基本面（單一商品詳情頁用，見 stock_fundamentals.py） ----
# 免費申請：https://finnhub.io/register。留空就不會顯示美股代幣（TSLA/AAPL/NVDA 等）的
# 公司基本面（產業別/市值/掛牌日期），不影響報價、技術分析、AI 新聞情緒等其他功能。
FINNHUB_API_KEY=

# 預設沒有背景排程／沒有自動輪詢：分析只在你按下網頁上的「立即分析」按鈕時才觸發一輪
# OKX + AI 呼叫，用量完全由點擊次數決定。想要自動化，見上面「背景排程自動分析」那兩節——
# 刻意需要主動開啟，開啟後 AI 用量仍然有三道防線把關，不會因為自動化就無上限燒 token。
